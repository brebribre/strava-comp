DATABASE_URL=postgresql+psycopg://strava:strava@localhost:5433/strava

# From https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/auth/strava/callback
STRAVA_SCOPE=read,activity:read_all

# Signs session cookies — generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Set true when served over HTTPS (production)
COOKIE_SECURE=false

# Phase 7
STRAVA_VERIFY_TOKEN=change-me

FRONTEND_ORIGIN=http://localhost:5173
